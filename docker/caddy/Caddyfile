# Reverse-proxy Next.js with automatic HTTPS via Let's Encrypt.
# Set DOMAIN as an environment variable (see docker-compose.yml).
{$DOMAIN}

encode zstd gzip

@api path /api/*
reverse_proxy app:3000

@static path /_next/*
reverse_proxy app:3000

reverse_proxy app:3000

log {
    output file /data/access.log {
        roll_size 10mb
        roll_keep 5
    }
}